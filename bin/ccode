#! /bin/bash

if [ -z "$BUILD_BASE" ]; then
  export BUILD_BASE=$(cd $(dirname "${BASH_SOURCE[0]}") && cd .. && pwd)
fi

export MOZSB_EXTRA_BIN_DIR=$(mktemp -d)

MOZSB_EXTRA_BINS=(
  jj
  lrv
)

for bin in "${MOZSB_EXTRA_BINS[@]}"; do
  if command -v $bin 1>/dev/null 2>&1; then
    cp $(mise which $bin) $MOZSB_EXTRA_BIN_DIR
  fi
done

if [ -n "$DOTFILES" ]; then
  REPO=$(git rev-parse --git-dir)
  mkdir -p "$REPO/info"
  ln -f "$DOTFILES/shared/git/gitignore" "$REPO/info/exclude" 2>/dev/null || cp "$DOTFILES/shared/git/gitignore" "$REPO/info/exclude"
fi

if [ -n "$CLAUDE_BINARY" ]; then
  export MOZSB_CLAUDE_BIN="$CLAUDE_BINARY"
fi

export MOZSB_SRC="$BUILD_BASE"

if [[ "${1:-}" != "--exec" ]]; then
  cp $BUILD_BASE/config/claude.json $MOZSB_EXTRA_BIN_DIR/claude.json
  args=()
  for arg in "$@"; do
    [[ "$arg" != --permission-mode=* ]] && args+=("$arg")
  done
  ~/moz-local-sandbox/ccode-macos claude --settings $MOZSB_EXTRA_BIN_DIR/claude.json "${args[@]}"
else
  ~/moz-local-sandbox/ccode-macos $@
fi

rm -rf $MOZSB_EXTRA_BIN_DIR
