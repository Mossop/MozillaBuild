#! /bin/bash

export CCODE_EXTRA_BIN_DIR=$(mktemp -d)
export MOZCONFIG=$CCODE_EXTRA_BIN_DIR/mozconfig

CCODE_EXTRA_BINS=(
  jj
  lrv
)

for bin in "${CCODE_EXTRA_BINS[@]}"; do
  cp $(mise which $bin) $CCODE_EXTRA_BIN_DIR
done

if [ -n "$DOTFILES" ]; then
  REPO=$(git rev-parse --git-dir)
  mkdir -p "$REPO/info"
  ln -f "$DOTFILES/shared/git/gitignore" "$REPO/info/exclude" 2>/dev/null || cp "$DOTFILES/shared/git/gitignore" "$REPO/info/exclude"
fi

$BUILD_BASE/bin/gen_mozconfig > $CCODE_EXTRA_BIN_DIR/mozconfig

export CCODE_SRC="$BUILD_BASE/source"

if [[ "${1:-}" != "--exec" ]]; then
  cp $BUILD_BASE/config/claude.json $CCODE_EXTRA_BIN_DIR/claude.json
  $BUILD_BASE/moz-local-sandbox/ccode-macos --settings $CCODE_EXTRA_BIN_DIR/claude.json $@
else
  $BUILD_BASE/moz-local-sandbox/ccode-macos $@
fi

rm -rf $CCODE_EXTRA_BIN_DIR
