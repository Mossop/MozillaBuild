#! /bin/bash

if [ -z "$BUILD_BASE" ]; then
  PARENT=$(cd $(dirname "${BASH_SOURCE[0]}") && pwd)
  . $PARENT/buildrc
fi

log() {
  echo "#${PREFIX} $@"
}

ac_add_options() {
  echo "ac_add_options $@"
}

ac_add_app_options() {
  echo "ac_add_app_options $@"
}

mk_add_options() {
  echo "mk_add_options $@"
}

export() {
  echo "export $@"
}

PREFIX=""
. $BUILD_BASE/bin/mozconfig
unset PREFIX
